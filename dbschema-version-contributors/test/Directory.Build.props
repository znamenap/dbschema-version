<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)../../Directory.Build.props"/>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <BaseOutputPath>$(MSBuildThisFileDirectory)../../output/contributors/test/bin</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../output/contributors/test/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(MSBuildThisFileDirectory)../../output/contributors/test/obj/$(MSBuildProjectName)/</MSBuildProjectExtensionsPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

</Project>